{
  "name": "sprintpark-ai-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "SprintPark AI Command Center (SAICC) - multi-tenant AI governance command center.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
